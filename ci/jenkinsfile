pipeline {
    agent any

    environment {
        // Replace with the public IP or DNS of your Docker EC2 instance
        DOCKER_EC2_IP = '3.213.238.99'
        // This is the ID of the SSH private key credential you stored in Jenkins
        SSH_CREDENTIAL_ID = 'docker-ec2-key' 
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Ben', url: 'https://github.com/BennyBach1002/COSC2767-Assignment-2.git'
            }
        }

        stage('SSH into Docker EC2 and Run Command') {
            steps {
                // The sshagent step injects the private key into the SSH agent for this block
                sshagent(credentials: [SSH_CREDENTIAL_ID]) {
                    sh """
                        # The 'ssh' command will now use the key from the agent for authentication
                        # -o StrictHostKeyChecking=no is used to bypass the host key check for the first connection
                        # 'ec2-user' is the default username for Amazon Linux instances
                        ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} "echo 'Hello from Jenkins! This is a test command.'"
                    """
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}