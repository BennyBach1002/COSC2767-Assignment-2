pipeline {
    agent any

    environment {
        // Replace with the public IP or DNS of your Docker EC2 instance
        DOCKER_EC2_IP = '3.213.238.99'
        // This is the ID of the SSH private key credential you stored in Jenkins
        SSH_CREDENTIAL_ID = 'docker-ec2-key'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Ben', url: 'https://github.com/BennyBach1002/COSC2767-Assignment-2.git'
            }
        }

        stage('SSH into Docker EC2 and Run Command') {
            steps {
                echo 'start testing'
                sshagent(credentials: [SSH_CREDENTIAL_ID]) {
                    sh """
                ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} "
                    # Remove any existing container named 'testing'
                    if docker ps -a --format '{{.Names}}' | grep -q 'testing'; then
                        echo 'Removing existing container: testing'
                        docker rm -f testing
                    fi
                    # Create the new container as the dockeradmin user
                    docker run -d --name testing nginx:alpine
                "
            """
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}
